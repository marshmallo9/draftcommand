PORT=3001
DB_PATH=./db/draft-insights.db
CORS_ORIGIN=*

# FantasyPros API (free personal/non-commercial key — request one at
# https://support.fantasypros.com/hc/en-us/articles/49749297704475).
# NEVER commit a real key — this file is the example; put the real value in
# your own .env (gitignored) or your host's environment variable settings.
FANTASYPROS_API_KEY=
# Scoring format for consensus rankings (PPR, HALF, STD).
FANTASYPROS_SCORING=PPR
# Minimum hours between real FantasyPros calls, regardless of how often
# sync is triggered — protects a quota-limited key. Check your own key's
# documented daily limit (visible in your FantasyPros dashboard, not public)
# and adjust; 20 is a conservative "about once a day" default.
FANTASYPROS_SYNC_COOLDOWN_HOURS=20
